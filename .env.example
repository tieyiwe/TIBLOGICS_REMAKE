# ============================================================
# TIBLOGICS ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Database (Supabase PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://tiblogics.com"            # http://localhost:3000 for local dev

# ── Admin credentials ─────────────────────────────────────
ADMIN_EMAIL="ai@tiblogics.com"
ADMIN_PASSWORD="your-strong-unique-password"    # Master admin key — keep secret, unique per deployment
ADMIN_NAME="Tieyiwe Bassole"

# ── Anthropic (Claude AI) ─────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."                 # sk_test_ for local dev
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_EVENT_PRICE_ID="price_..."              # Price ID for event registrations (live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..." # pk_test_ for local dev

# ── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://tiblogics.com"     # http://localhost:3000 for local dev

# ── Resend (transactional email) ──────────────────────────
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@tiblogics.com"
TIWE_EMAIL="ai@tiblogics.com"

# ── SMTP — Titan (info@tiblogics.com) ─────────────────────
TITAN_SMTP_HOST="smtp.titan.email"
TITAN_SMTP_PORT="465"
TITAN_SMTP_USER="info@tiblogics.com"
TITAN_SMTP_PASS="your-titan-password"

# ── SMTP — ARFA (arfa@tiblogics.com) ──────────────────
ARFA_SMTP_USER="arfa@tiblogics.com"
ARFA_SMTP_PASS="your-arfa-smtp-password"

# ── Operational secrets ───────────────────────────────────
CRON_SECRET="generate-with: openssl rand -base64 32"   # Protects /api/blog/fill-translations
RESET_TOKEN="generate-with: openssl rand -base64 32"   # Admin password reset

# ── Social posting (optional) ─────────────────────────────
LINKEDIN_ACCESS_TOKEN="your-linkedin-token"
LINKEDIN_PERSON_URN="urn:li:person:..."

TWITTER_APP_KEY="..."
TWITTER_APP_SECRET="..."
TWITTER_ACCESS_TOKEN="..."
TWITTER_ACCESS_SECRET="..."
TWITTER_BEARER_TOKEN="..."

FACEBOOK_PAGE_ID="..."
FACEBOOK_PAGE_ACCESS_TOKEN="..."

# ── Google Places (optional) ──────────────────────────────
GOOGLE_PLACES_API_KEY="..."

# ── Internal notifications ────────────────────────────────
DESIGN_EMAIL="design@tiblogics.com"

# ── Narrated lesson videos (lib/learn/video, cron "videos") ─
# Voice: Google Cloud Text-to-Speech (preferred) or OpenAI TTS. With neither,
# no videos are made (jobs wait as "needs voice key").
GOOGLE_TTS_API_KEY=""
# GOOGLE_TTS_VOICE_EN="en-US-Neural2-F"
# GOOGLE_TTS_VOICE_FR="fr-FR-Neural2-A"
# GOOGLE_TTS_RATE="1.0"
# OPENAI_API_KEY=""                 # fallback voice (gpt-4o-mini-tts)
# VIDEO_MAX_PER_RUN="2"             # videos per cron run (every 15 min)
# VIDEO_STORAGE=""                  # object | db (default: Replit Object Storage when available)
# VIDEO_WEBM="0"                    # 1 = also store a VP9/WebM copy

# ============================================================
# SETUP CHECKLIST FOR PRODUCTION
# ============================================================
#
# 1. DATABASE:
#    - Supabase project: supabase.com
#    - Use the Session mode pooler URL (port 5432) for DATABASE_URL
#    - Run: npx prisma generate  (in build step)
#    - Visit /admin_pro/events → click "Sync DB" after first deploy
#
# 2. NEXTAUTH:
#    - NEXTAUTH_SECRET: openssl rand -base64 32
#    - NEXTAUTH_URL must match your production domain exactly
#
# 3. STRIPE (LIVE):
#    - Switch sk_test_ → sk_live_ and pk_test_ → pk_live_
#    - Webhook URL: https://tiblogics.com/api/stripe/webhook
#    - Events to listen: checkout.session.completed
#    - STRIPE_EVENT_PRICE_ID must be a live Price ID (not test)
#
# 4. SMTP:
#    - TITAN handles info@tiblogics.com (general contact/blog)
#    - ARFA handles arfa@tiblogics.com (training emails, sale alerts)
#    - Both must be configured or event confirmation emails will fail
#
# 5. CRON_SECRET:
#    - Required — endpoint returns 401 for all requests if not set
#    - Set this in Replit Secrets / Vercel Environment Variables
#
# 6. ADMIN_PASSWORD:
#    - This is the master key for the single admin account
#    - Use a strong unique password — never reuse across deployments
