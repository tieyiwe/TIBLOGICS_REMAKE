{
  "name": "tiblogics-remake",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider next dev --port 5000",
    "prebuild": "node scripts/check-lockfile.mjs",
    "build": "NODE_OPTIONS=--openssl-legacy-provider prisma generate && next build",
    "start": "NODE_OPTIONS=--openssl-legacy-provider next start -H 0.0.0.0 -p 5000",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "cron": "node scripts/cron.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.5.0",
    "@replit/object-storage": "^1.0.0",
    "autoprefixer": "^10.4.14",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.475.0",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^8.0.7",
    "postcss": "^8.4.24",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
