  @@index([promotionId, createdAt])
}

/// Promotion settings, e.g. key "referral": the referral welcome discount.
model PromotionSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @default(now())
}

/// Shared invalidation counter for the in-process public data cache
/// (lib/cache/public-data.ts). A write to cached content bumps its tag; every
/// instance compares versions every few seconds. Created at runtime too.
model CacheVersion {
  tag       String   @id
  version   Int      @default(0)
  updatedAt DateTime @default(now())
}

/// Machine-translation cache for course, lab, toolkit and article content
/// (lib/i18n/content.ts). Table created at runtime; keep in step.
model ContentTranslation {
