// ── Tilo Vision Scholarship (admin: /admin_pro/learn/scholarships) ─────────
// Tables are created at runtime by lib/learn/scholarship/db.ts (no
// migrations); keep the two in step. No relations, so they never touch the
// shared models. Individual tracks only: never team plans or the monthly plan.

/// One award to one person. status: draft (being reviewed) | approved
/// (congratulations email sent, waiting to be accepted) | claimed (accepted by
/// the learner `studentId`) | revoked. The offer link expires at
/// offerExpiresAt while approved. trackIds: the tracks it may be used on
/// (empty = any live track). coveragePct: 1-100 (100 = free).
model Scholarship {
  id             String    @id
  code           String    @unique
  name           String
  email          String
  locale         String    @default("en")
  trackCount     Int
  coveragePct    Int
  trackIds       String[]  @default([])
  message        String?
  note           String?
  status         String    @default("draft")
  tokenHash      String?   @unique
  offerDays      Int       @default(30)
  offerExpiresAt DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  emailedAt      DateTime?
  studentId      String?
  claimedAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  /// Stripe coupon (percent_off = coveragePct) shown as the scholarship discount at checkout.
  stripeCouponId String?
  /// Who funds it (impact reports go to sponsorEmail).
  sponsorName    String?
  sponsorEmail   String?
  /// Days after accepting to choose the tracks (unused ones then expire).
  pickDays       Int?
  /// Target days after accepting to complete the tracks (reminders only).
  completeDays   Int?
  welcomedAt     DateTime?
  /// The public application it came from, if any.
  applicationId  String?
  /// The partner organisation it is given through, and how the mention
  /// reads: partnership ("In partnership with") | nominated ("Nominated by")
  /// | through ("Awarded through"). Printed on the email and award letter.
  partnerName    String?
  partnerRole    String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([email])
  @@index([studentId])
  @@index([status, createdAt])
  @@index([sponsorName])
}

/// A track unlocked with a scholarship: free (paidCents 0) or paid at the
/// scholarship price through Stripe (stripeSessionId).
model ScholarshipTrack {
  id              String   @id
  scholarshipId   String
  studentId       String
  trackId         String
  listCents       Int
  paidCents       Int
  coveredCents    Int
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  @@unique([scholarshipId, trackId])
  @@index([studentId])
}

/// A reminder or update already sent for a scholarship (kind: offer-reminder,
/// pick-7, pick-1, complete-half, complete-14, progress-<n>, completed), so
/// the daily job sends each once.
model ScholarshipNotice {
  id            String   @id
  scholarshipId String
  kind          String
  sentAt        DateTime @default(now())

  @@unique([scholarshipId, kind])
}

/// An application from the public page /tilo-vision-scholarship.
/// status: new | shortlisted | declined | awarded (scholarshipId).
model ScholarshipApplication {
  id            String    @id
  name          String
  email         String
  phone         String?
  country       String?
  locale        String    @default("en")
  background    String?
  motivation    String
  goals         String?
  trackIds      String[]  @default([])
  links         String?
  status        String    @default("new")
  reviewNote    String?
  reviewedAt    DateTime?
  reviewedBy    String?
  scholarshipId String?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([status, createdAt])
}

/// A gift to the Tilo Vision Scholarship fund (public donate box). One row per
/// payment: stage first (the checkout; thanked by email) or renewal (each
/// monthly invoice). frequency: once | monthly. canceledAt: a monthly gift
/// stopped (on its first row).
model ScholarshipDonation {
  id                   String    @id
  frequency            String
  stage                String    @default("first")
  amountCents          Int
  currency             String    @default("usd")
  email                String?
  name                 String?
  locale               String    @default("en")
  stripeSessionId      String?   @unique
  stripeInvoiceId      String?   @unique
  stripeSubscriptionId String?
  stripeCustomerId     String?
  thankedAt            DateTime?
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())

  @@index([createdAt])
  @@index([stripeSubscriptionId])
}

/// A sponsor impact report sent (lib/learn/scholarship/sponsor-reports.ts,
/// created at runtime). key: "auto:<sponsor>:<YYYY-MM>" for the automatic
/// monthly report (claimed before sending), "manual:<id>" for one sent from
/// admin. sponsor: the sponsor name, trimmed and lower-cased.
model ScholarshipSponsorReport {
  key     String   @id
  sponsor String
  month   String?
  sentTo  String?
  sentAt  DateTime @default(now())

  @@index([sponsor, sentAt])
}

/// One row per payment already announced to sales@ (lib/payments/sale-alert.ts,
/// created at runtime). The id is the Stripe Checkout session or invoice id.
model SaleAlert {
  id        String   @id
  createdAt DateTime @default(now())
}

/// One track on its own monthly plan (lib/learn/track-subscriptions.ts,
/// created at runtime). One row per Stripe subscription.
model TrackSubscription {
  id                   String    @id
  studentId            String
  trackId              String
  stripeSubscriptionId String    @unique
  stripeCustomerId     String?
  status               String
  currentPeriodEnd     DateTime?
  graceUntil           DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@index([studentId])
}

/// Instant-feedback quiz session (lib/learn/quiz-session.ts, created at
/// runtime): the questions served and the answers locked as they were shown.
model QuizSession {
  id          String   @id
  studentId   String
  mode        String
  refId       String
  questionIds String[]
  locks       Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([studentId])
}

/// Glossary terms a learner opened in lessons, reviewed as flip cards in the
/// Daily Review with Leitner boxes (lib/learn/glossary/review.ts, created at runtime).
model GlossarySeen {
  studentId      String
  termId         String
  firstSeenAt    DateTime  @default(now())
  lastReviewedAt DateTime?
  box            Int       @default(1)
  dueAt          DateTime

  @@id([studentId, termId])
  @@index([studentId, dueAt])
}

/// "Explain simpler" on a lesson paragraph, written once per paragraph text
/// and language and shared by every learner (lib/learn/explain, created at runtime).
model ParagraphExplain {
  lessonId  String
  paraHash  String
  locale    String
  text      String
  createdAt DateTime @default(now())

  @@id([lessonId, paraHash, locale])
}
