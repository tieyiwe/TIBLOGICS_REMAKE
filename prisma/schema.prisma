generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

// Host-neutral. Supabase was only ever a Postgres host for this project —
// no Supabase Auth, Storage, Realtime or RLS is used — so moving providers
// is a connection-string change. lib/prisma.ts still accepts the old
// SUPABASE_URL as an alias so the app keeps running mid-migration.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Appointment {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  serviceType      String
  serviceDuration  String
  servicePrice     Int
  date             DateTime
  timeSlot         String
  timezone         String            @default("America/New_York")
  firstName        String
  lastName         String
  email            String
  company          String?
  phone            String?
  goalNotes        String?
  addOnRecording   Boolean           @default(false)
  addOnActionPlan  Boolean           @default(false)
  addOnSlackAccess Boolean           @default(false)
  totalAmount      Int
  status           AppointmentStatus @default(PENDING)
  stripeSessionId  String?
  stripePaymentId  String?
  paymentStatus    String?
  zoomLink         String?
  notes            String?
  reminderSent     Boolean           @default(false)
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  @@index([email])
  @@index([date])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Prospect {
  id                 String         @id @default(cuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  name               String
  business           String
  industry           String
  mainChallenge      String
  budget             String
  suggestedSolutions String[]
  email              String?
  phone              String?
  source             ProspectSource @default(TIBS_ADVISOR)
  status             ProspectStatus @default(NEW)
  priority           String?
  estimatedValue     Int?
  notes              String?
  followUpDate       DateTime?
  convertedAt        DateTime?
  conversationLog    Json?
  archived           Boolean        @default(false)

  @@index([status])
  @@index([createdAt])
  @@index([archived])
}

enum ProspectSource {
  TIBS_ADVISOR
  WEBSITE_SCANNER
  CONTACT_FORM
  REFERRAL
  MANUAL
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

model ScannerLead {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  url           String
  overallScore  Int
  seoScore      Int
  perfScore     Int
  uxScore       Int
  aiScore       Int
  findings      Json
  aiDescription String
  email         String?
  name          String?
  bookedCallAt  DateTime?
  /// Columns below are created at runtime by lib/scanner/db.ts (and dbprep).
  /// The site's key for the free-scan limit: lower-case host without "www.".
  domain          String?
  /// Secret report link: /tools/scanner/report/<token>.
  token           String?   @unique
  locale          String?
  /// Growth and security scores, extra findings, detected tools, ideas, PageSpeed.
  extra           Json?
  unlockedAt      DateTime?
  /// "paid" | "call" | "admin"
  unlockSource    String?
  stripeSessionId String?
  amountPaid      Int?
  /// The written full report (fix steps, build ideas), made once when unlocked.
  report          Json?
  reportStatus    String?
  /// Competitor sites compared in the full report.
  compare         Json?
  /// A paid report includes one re-scan of the same site within 30 days.
  rescanCredits   Int       @default(0)
  rescanUntil     DateTime?
  /// The scan this one re-measured, when it used a re-scan credit.
  parentId        String?
  emailedAt       DateTime?
  followupStage   Int       @default(0)
  followupAt      DateTime?
  consentAt       DateTime?
  growthLeadId    String?
  /// The booking made from this report (/book?scan=<token>).
  appointmentId   String?

  @@index([createdAt])
  @@index([aiScore])
  @@index([domain, createdAt])
  @@index([followupAt])
  @@index([appointmentId])
}

/// A paid Readiness Monitor: one customer site plus up to three competitors,
/// rescanned on a schedule. Tables are created by lib/monitor/db.ts on first
/// use, since this project has no migrations.
model MonitorSubscription {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  email                String
  name                 String?
  siteUrl              String
  competitors          String[]
  /// pending (checkout not finished) | active | past_due | canceled
  status               String    @default("pending")
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  /// The dashboard link is derived from this salt (see lib/monitor/token.ts);
  /// only the link's hash is stored.
  tokenSalt            String
  tokenHash            String    @unique
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  /// Set while a run is in progress, so two cron calls cannot scan twice.
  runStartedAt         DateTime?
  lastManualRunAt      DateTime?

  scans MonitorScan[]

  @@index([status, nextRunAt])
  @@index([email])
}

model MonitorScan {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  subscriptionId String
  subscription   MonitorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Every site scanned in one pass shares a runId.
  runId          String
  url            String
  isOwn          Boolean
  ok             Boolean
  error          String?
  overallScore   Int?
  seoScore       Int?
  perfScore      Int?
  uxScore        Int?
  aiScore        Int?
  findings       Json?

  @@index([subscriptionId, createdAt])
  @@index([runId])
}

/// Toolkit Live / Compliance Guard subscription, one per TIBLOGICS account.
/// Tables are created by lib/toolkit/db.ts on first use (no migrations).
model ToolkitSubscription {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  studentId            String    @unique
  /// toolkit (prompts + guard) | guard (Compliance Guard only)
  plan                 String
  /// active | trialing | past_due | canceled
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
}

/// What the tool knows about the customer's business, sent with every run.
model ToolkitProfile {
  studentId       String   @id
  updatedAt       DateTime @updatedAt
  businessName    String   @default("")
  vertical        String   @default("general")
  location        String   @default("")
  audience        String   @default("")
  offer           String   @default("")
  voice           String   @default("")
  differentiators String   @default("")
  /// Licence numbers, brokerage, required disclosures: things that must appear.
  compliance      String   @default("")
}

/// Every generation and check. Doubles as the usage meter.
model ToolkitRun {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  studentId    String
  /// generate | check | deep-check
  kind         String
  promptId     String?
  title        String
  input        String   @db.Text
  output       String   @db.Text
  findings     Json?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  @@index([studentId, createdAt])
  @@index([studentId, kind, createdAt])
}

/// A paid Automation Blueprint: intake answers in, a written plan out.
/// Created by lib/blueprint/db.ts on first use (no migrations).
model Blueprint {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  email               String
  name                String
  company             String
  /// draft (checkout not finished) | paid | generating | ready | failed
  status              String    @default("draft")
  intake              Json
  result              Json?
  error               String?
  attempts            Int       @default(0)
  generationStartedAt DateTime?
  stripeSessionId     String?   @unique
  amountPaid          Int       @default(0)
  paidAt              DateTime?
  readyAt             DateTime?
  /// Quoted when booking a build; the amount paid comes off the engagement.
  creditCode          String    @unique
  creditExpiresAt     DateTime?
  creditUsedAt        DateTime?
  tokenSalt           String
  tokenHash           String    @unique
  inputTokens         Int       @default(0)
  outputTokens        Int       @default(0)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model ToolUsage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tool      String
  sessionId String?
  metadata  Json?
}

model AdminSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Rate-limit counters. Shared so a limit survives a restart and holds across
/// instances — the in-memory version reset on every deploy and counted per
/// instance. Rows are disposable; pruneRateLimits() clears expired ones.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Project {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  name             String
  description      String?
  category         ProjectCategory
  status           ProjectStatus   @default(ACTIVE)
  priority         ProjectPriority @default(MEDIUM)
  progress         Int             @default(0)
  color            String          @default("#2251A3")
  revenueEarned    Int             @default(0)
  revenuePotential Int             @default(0)
  monthlyRecurring Int             @default(0)
  startDate        DateTime?
  deadline         DateTime?
  completedAt      DateTime?
  starred          Boolean         @default(false)
  archived         Boolean         @default(false)
  notes            String?
  tasks            ProjectTask[]
  // Command Center additions (lib/admin/command-center/db.ts adds the columns
  // at runtime; all nullable or defaulted so existing rows are unchanged).
  ownerId          String?
  health           String          @default("on_track")
  healthNote       String?
  goals            String?
  links            Json            @default("[]")
  progressMode     String          @default("manual")
  hourlyRateCents  Int?
  clientName       String?
  clientEmail      String?
  prospectId       String?
  templateKey      String?
  lastUpdateAt     DateTime?

  @@index([category])
  @@index([status])
}

enum ProjectCategory {
  SAAS
  CLIENT
  EDUCATION
  INTERNAL
}

enum ProjectStatus {
  CONCEPT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProjectTask {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  dueDate   DateTime?
  order     Int       @default(0)
  // Command Center additions (runtime columns, see lib/admin/command-center/db.ts)
  status          String    @default("todo") // todo | in_progress | review | done
  priority        String    @default("none") // none | low | medium | high | urgent
  assigneeId      String? // "owner" or a Collaborator id
  description     String?
  labels          String[]  @default([])
  parentId        String? // subtask of another ProjectTask
  startDate       DateTime?
  estimateMinutes Int?
  blockedBy       String[]  @default([])
  recurrence      String? // weekly | monthly
  completedAt     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
  createdById     String?
  milestoneId     String?
  links           Json      @default("[]")

  @@index([projectId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String?
  whatsapp       String?
  source         String    @default("blog")
  active         Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([active])
  @@index([subscribedAt])
}

model NewsletterCampaign {
  id             String    @id @default(cuid())
  title          String
  subject        String
  previewText    String?
  contentHtml    String    @db.Text
  category       String    @default("general")
  status         String    @default("DRAFT")
  sentAt         DateTime?
  recipientCount Int       @default(0)
  sentBy         String    @default("Echelon")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ServiceRequest {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  service      String
  description  String   @db.Text
  budget       String?
  timeline     String?
  tiboAssisted Boolean  @default(false)
  aiSummary    String?  @db.Text
  status       String   @default("NEW")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.Text
  content       String   @db.Text
  category      String
  tags          String[]
  coverImage    String?
  coverEmoji    String   @default("🤖")
  coverGradient String   @default("from-[#1B3A6B] to-[#2251A3]")
  author        String   @default("Echelon AI")
  readingTime   Int      @default(5)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  aiGenerated   Boolean  @default(false)
  sourceUrl     String?
  sourceTitle   String?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([createdAt])
  @@index([published, createdAt])
}

model BreakingNews {
  id        String    @id @default(cuid())
  headline  String
  summary   String
  sourceUrl String?
  source    String?
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model BlogRefreshLog {
  id         String   @id @default(cuid())
  success    Boolean
  postsAdded Int      @default(0)
  message    String?
  createdAt  DateTime @default(now())
}

model CommandCenterSync {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  projectId   String?
  projectName String
  action      String
  source      String
  changesDiff Json
  chatSummary String?
  undoneAt    DateTime?
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  referrer  String?
  origin    String   @default("direct")
  device    String   @default("desktop")
  browser   String?
  os        String?
  ip        String?
  country   String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([origin])
}

model ActiveSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  page      String
  device    String   @default("desktop")
  browser   String?
  os        String?
  origin    String   @default("direct")
  country   String?
  ip        String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([lastSeen])
}

model Collaborator {
  id            String                    @id @default(cuid())
  name          String
  email         String                    @unique
  passwordHash  String?
  role          String                    @default("CUSTOM")
  permissions   String[]
  isAdmin       Boolean                   @default(false)
  active        Boolean                   @default(true)
  inviteToken   String?                   @unique
  inviteExpires DateTime?
  invitedBy     String
  lastLoginAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  activityLogs  CollaboratorActivityLog[]
  access        StaffAccess?

  @@index([email])
  @@index([inviteToken])
}

model CollaboratorActivityLog {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  action         String
  resource       String
  resourceId     String?
  details        String?
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([collaboratorId])
  @@index([createdAt])
  @@index([resource])
}

model AgentLead {
  id             String          @id @default(cuid())
  source         String          @default("ai_generated")
  companyName    String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  location       String?
  industry       String?
  description    String?         @db.Text
  notes          String?         @db.Text
  status         AgentLeadStatus @default(NEW)
  fromAgent      String          @default("aria")
  assignedTo     String?
  callSid        String?
  callStatus     String?
  callNotes      String?         @db.Text
  callTranscript String?         @db.Text
  callSummary    String?         @db.Text
  interestedIn   String[]
  hasWebsite     Boolean?
  businessInfo   Json?
  scrapedAt      DateTime?
  area           String?
  transferredAt  DateTime?
  contactedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([fromAgent])
  @@index([assignedTo])
}

enum AgentLeadStatus {
  NEW
  TRANSFERRED
  CONTACTED
  HOT
  WARM
  COLD
  UNINTERESTED
  CONVERTED
}

model AgentMessage {
  id        String   @id @default(cuid())
  fromAgent String
  toAgent   String
  type      String   @default("notification")
  subject   String?
  payload   Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model AgentRun {
  id        String   @id @default(cuid())
  agent     String
  action    String
  status    String   @default("running")
  input     Json?
  output    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agent])
  @@index([status])
}

model PartnershipApplication {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  website      String?
  address      String?
  description  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  product   String
  createdAt DateTime @default(now())

  @@unique([email, product])
  @@index([product])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// TIBLOGICS LEARN — course platform
// Status-like columns are String (validated in lib/learn/types.ts) rather than
// Postgres enums, so the raw-SQL sync-db path stays idempotent and simple.
// ═══════════════════════════════════════════════════════════════════════════

model Student {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  email             String    @unique
  passwordHash      String
  name              String
  emailVerified     DateTime?
  verifyToken       String?   @unique
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  accessibilityMode Boolean   @default(false)
  locale            String    @default("en")
  leaderboardOptIn  Boolean   @default(false)
  lastLoginAt       DateTime?

  subscription  LearnSubscription?
  progress      LessonProgress[]
  microAttempts MicroCheckAttempt[]
  quizAttempts  QuizAttempt[]
  examSessions  FinalExamSession[]
  capstones     CapstoneSubmission[]
  points        PointsLedger[]
  certificates  LearnCertificate[]
  labAttempts   LabAttempt[]
  reviewCards   ReviewCard[]
  reflections   LessonReflection[]
  portfolio     PortfolioSettings?
  trackPurchases TrackPurchase[]
  drafts        LearnerDraft[]

  @@index([email])
}

model LearnTrack {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  slug                 String    @unique
  title                String
  titleFr              String?
  tagline              String?
  description          String    @db.Text
  descriptionFr        String?   @db.Text
  level                String    @default("beginner") // starter|beginner|intermediate|advanced
  levelEnd             String? // set when the track spans levels
  status               String    @default("draft") // draft|coming_soon|live
  sortOrder            Int       @default(0)
  accentColor          String    @default("#F47C4C")
  heroImage            String?
  outcomes             Json      @default("[]")
  audience             String?
  certificateName      String
  estimatedHours       Float     @default(0)
  estimatedWeeksAt3Hrs Int?
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt             DateTime?
  /// One-time price in cents. Null = from the level (lib/learn/pricing.ts).
  /// Added at runtime (lib/learn/admin/columns.ts).
  priceCents           Int?

  modules      LearnModule[]
  finalExam    FinalExam?
  capstone     Capstone?
  certificates LearnCertificate[]
  labs         Lab[]

  @@index([status])
  @@index([sortOrder])
}

model LearnModule {
  id               String     @id @default(cuid())
  trackId          String
  track            LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  sortOrder        Int
  estimatedMinutes Int        @default(0)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt         DateTime?

  lessons Lesson[]
  quiz    Quiz?
  examQs  FinalExamQuestion[]
  labs    Lab[]

  @@index([trackId])
}

model Lesson {
  id              String      @id @default(cuid())
  moduleId        String
  module          LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  sortOrder       Int
  contentType     String      @default("mixed") // video|article|mixed
  videoUrl        String?
  bodyMd          String      @db.Text
  durationMinutes Int         @default(0)
  objective       String?
  isPreview       Boolean     @default(false)
  hasPractice     Boolean     @default(false)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt        DateTime?
  /// When the lesson was added. Null for lessons that predate the column
  /// (lib/learn/admin/columns.ts adds it without back-filling), so only
  /// lessons added later can show as "New in this track".
  createdAt       DateTime?   @default(now())

  resources   LessonResource[]
  microCheck  MicroCheck?
  progress    LessonProgress[]
  labs        Lab[]
  reflections LessonReflection[]

  @@index([moduleId])
  recap         LessonRecap?
}

model LessonResource {
  id                String  @id @default(cuid())
  lessonId          String
  lesson            Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title             String
  url               String
  resourceType      String  @default("tool") // tool|article|video|dataset|template|account_signup
  isFree            Boolean @default(true)
  isRequired        Boolean @default(false)
  notes             String?
  sortOrder         Int     @default(0)
  lastCheckedStatus Int? // admin link checker result

  @@index([lessonId])
}

// ── Tier 1: micro-checks (after every lesson) ──────────────────────────────
model MicroCheck {
  id              String    @id @default(cuid())
  lessonId        String    @unique
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passScore       Int       @default(67)
  questionsServed Int       @default(3)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt        DateTime?

  questions MicroCheckQuestion[]
  attempts  MicroCheckAttempt[]
}

model MicroCheckQuestion {
  id           String     @id @default(cuid())
  microCheckId String
  microCheck   MicroCheck @relation(fields: [microCheckId], references: [id], onDelete: Cascade)
  question     String     @db.Text
  options      Json
  correctIndex Int
  explanation  String     @db.Text

  @@index([microCheckId])
}

model MicroCheckAttempt {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  microCheckId String
  microCheck   MicroCheck @relation(fields: [microCheckId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  answers      Json
  createdAt    DateTime   @default(now())

  @@index([studentId])
  @@index([microCheckId])
}

// ── Tier 2: module quizzes ─────────────────────────────────────────────────
model Quiz {
  id              String      @id @default(cuid())
  moduleId        String      @unique
  module          LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  passScore       Int         @default(80)
  questionsServed Int         @default(8)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt        DateTime?

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question     String @db.Text
  options      Json
  correctIndex Int
  explanation  String @db.Text

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([quizId])
}

// ── Tier 3: timed final exam ───────────────────────────────────────────────
model FinalExam {
  id               String     @id @default(cuid())
  trackId          String     @unique
  track            LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title            String
  timeLimitMinutes Int
  questionsServed  Int
  passScore        Int        @default(75)
  distinctionScore Int        @default(90)
  maxAttempts      Int        @default(3)
  cooldownHours    Int        @default(24)
  instructionsMd   String     @db.Text
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt         DateTime?

  questions FinalExamQuestion[]
  sessions  FinalExamSession[]
}

model FinalExamQuestion {
  id           String       @id @default(cuid())
  finalExamId  String
  finalExam    FinalExam    @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       LearnModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  question     String       @db.Text
  options      Json
  correctIndex Int
  explanation  String       @db.Text
  difficulty   Int          @default(2) // 1=recall 2=application 3=analysis

  @@index([finalExamId])
  @@index([moduleId])
}

model FinalExamSession {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  finalExamId     String
  finalExam       FinalExam @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  status          String    @default("in_progress") // in_progress|submitted|expired
  questionIds     Json
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  score           Int?
  passed          Boolean?
  answers         Json      @default("{}")
  perModuleScores Json?
  attemptNumber   Int       @default(1)

  @@index([studentId])
  @@index([finalExamId])
  @@index([status])
}

// ── Labs ───────────────────────────────────────────────────────────────────
// Hands-on practice. Three kinds, all sharing one attempt model:
//   prompt   — write a prompt, run it against a real model in a sandbox,
//              get coached on the PROMPT rather than the output
//   critique — spot the planted flaws in a supplied AI answer
//   build    — do a real task, tick the steps, submit an artefact
model Lab {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  trackId   String
  track     LearnTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    LearnModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessonId  String?
  lesson    Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  slug             String    @unique
  title            String
  labType          String    @default("prompt") // prompt|critique|build
  briefMd          String    @db.Text
  scenarioMd       String?   @db.Text
  /**
   * Criteria the attempt is scored against. Shown to the learner up front.
   */
  objectives       Json      @default("[]")
  /**
   * Type-specific settings (planted flaws, checklist steps, sandbox system prompt).
   */
  config           Json      @default("{}")
  passScore        Int       @default(70)
  points           Int       @default(40)
  estimatedMinutes Int       @default(20)
  sortOrder        Int       @default(0)
  isPublished      Boolean   @default(true)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt         DateTime?

  attempts LabAttempt[]

  @@index([trackId])
  @@index([lessonId])
}

model LabAttempt {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  status     String   @default("in_progress") // in_progress|submitted
  /**
   * Learner's work: prompt text, selections, checklist state, artefact URL.
   */
  submission Json     @default("{}")
  /**
   * Sandbox conversation, for prompt labs.
   */
  transcript Json     @default("[]")
  score      Int?
  passed     Boolean  @default(false)
  feedbackMd String?  @db.Text
  /**
   * Per-objective outcome, so feedback can be shown against each criterion.
   */
  breakdown  Json?
  runCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
  @@index([labId])
  @@index([status])
}

// ── Capstone ───────────────────────────────────────────────────────────────
model Capstone {
  id            String     @id @default(cuid())
  trackId       String     @unique
  track         LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  briefMd       String     @db.Text
  rubric        Json
  passThreshold Int        @default(70)
  /// Set when staff edit this in the admin; the seed then leaves it alone.
  editedAt      DateTime?

  submissions CapstoneSubmission[]
}

model CapstoneSubmission {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  capstoneId    String
  capstone      Capstone  @relation(fields: [capstoneId], references: [id], onDelete: Cascade)
  status        String    @default("submitted") // submitted|in_review|revisions_requested|passed|failed
  submissionUrl String?
  submissionMd  String?   @db.Text
  reviewerNotes String?   @db.Text
  aiPrereviewMd String?   @db.Text
  score         Int?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentId])
  @@index([capstoneId])
  @@index([status])
}

// ── Learner state ──────────────────────────────────────────────────────────
model LearnSubscription {
  id                   String    @id @default(cuid())
  studentId            String    @unique
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  status               String    @default("trialing") // trialing|active|past_due|canceled
  plan                 String    @default("monthly") // monthly|annual
  currentPeriodEnd     DateTime?
  graceUntil           DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Created at runtime (lib/learn/track-subscriptions.ts): this all-tracks
  /// plan still includes the tracks now sold on their own monthly plan.
  allTracksLegacy      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

model LessonProgress {
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([studentId, lessonId])
  @@index([studentId])
  @@index([completedAt])
}

model PointsLedger {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  source    String // lesson_complete|micro_check_pass|quiz_pass|quiz_perfect|final_exam_pass|final_exam_distinction|capstone_pass|streak_bonus|track_complete
  refId     String?
  points    Int
  createdAt DateTime @default(now())

  @@unique([studentId, source, refId])
  @@index([studentId])
  @@index([studentId, createdAt])
}

model LearnCertificate {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trackId         String
  track           LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  verificationId  String     @unique @default(uuid())
  recipientName   String
  certificateName String
  distinction     Boolean    @default(false)
  examScore       Int?
  issuedAt        DateTime   @default(now())
  pdfUrl          String?
  revoked         Boolean    @default(false)
  /// ARFA-<track>-<year>-<8 chars>: printed, LinkedIn credential ID, verify link (lib/learn/cert/ref.ts).
  reference       String?    @unique
  /// Set when the learner confirms the name to print; then it is emailed and downloadable.
  nameConfirmedAt DateTime?
  emailedAt       DateTime?

  @@unique([studentId, trackId])
  @@index([verificationId])
}

model LearnWaitlist {
  id        String   @id @default(cuid())
  email     String
  trackSlug String
  createdAt DateTime @default(now())

  @@unique([email, trackSlug])
  @@index([trackSlug])
}

model Product {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  slug           String   @unique
  name           String
  tagline        String?
  description    String   @db.Text
  price          Int      @default(0) // current price in cents
  compareAtPrice Int? // original price (strike-through when on sale)
  currency       String   @default("USD")
  images         String[] // image URLs (first = primary)
  category       String   @default("General")
  collections    String[] // slugs of collections this product belongs to
  tags           String[]
  stock          Int? // null = not tracked / unlimited
  digital        Boolean  @default(true) // digital => no shipping address collected
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  onSale         Boolean  @default(false)
  sku            String?
  soldCount      Int      @default(0)

  // ── Digital delivery ───────────────────────────────────────────────────
  // deliveryType decides what a buyer receives:
  //   download — a file served through /api/shop/download/[token]
  //   external — a hosted resource (Notion, Sheets) opened via the same
  //              token check, so the link is never exposed before purchase
  //   none     — nothing to deliver (physical or service items)
  deliveryType  String  @default("none")
  /**
   * Path under private/downloads/. Deliberately NOT in /public: anything
   * there is fetchable without paying.
   */
  fileKey       String?
  /**
   * Filename the buyer sees when saving.
   */
  fileName      String?
  fileFormat    String?
  fileSizeBytes Int?
  /**
   * Destination for deliveryType = external.
   */
  externalUrl   String?
  /**
   * How long a purchase stays downloadable, and how many times.
   */
  downloadDays  Int     @default(365)
  maxDownloads  Int     @default(10)

  grants DownloadGrant[]

  @@index([published])
  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  description String   @default("")
  image       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@index([published])
  @@index([featured])
}

model AbandonedCart {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  email          String    @unique
  items          Json // [{ id, slug, name, price, image, quantity }]
  subtotal       Int       @default(0)
  currency       String    @default("USD")
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  recoveredAt    DateTime?

  @@index([recoveredAt])
  @@index([updatedAt])
}

/// One buyer's right to download one product from one paid order.
/// Created only by the Stripe webhook after payment, so a grant existing is
/// itself proof of purchase.
model DownloadGrant {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  /**
   * Random, unguessable; this is the credential in the download URL.
   */
  token          String    @unique
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /**
   * Denormalised so a grant still works if the buyer's order email changes.
   */
  email          String
  downloadCount  Int       @default(0)
  maxDownloads   Int       @default(10)
  expiresAt      DateTime
  lastDownloadAt DateTime?

  @@index([orderId])
  @@index([email])
  @@index([token])
}

model Order {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderNumber     String   @unique
  email           String
  customerName    String?
  phone           String?
  items           Json // [{ productId, slug, name, price, quantity, image }]
  subtotal        Int      @default(0)
  total           Int      @default(0)
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | fulfilled | cancelled | refunded
  stripeSessionId String?
  shippingAddress Json?
  notes           String?

  grants DownloadGrant[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Event {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  title             String
  slug              String    @unique
  description       String    @db.Text
  content           String?   @db.Text
  type              String    @default("TRAINING")
  price             Int       @default(0)
  currency          String    @default("USD")
  capacity          Int?
  location          String    @default("Online")
  date              DateTime?
  endDate           DateTime?
  timeSlot          String?
  timezone          String    @default("America/New_York")
  coverImage        String?
  tags              String[]
  featured          Boolean   @default(false)
  published         Boolean   @default(false)
  registrationOpen  Boolean   @default(true)
  stripePaymentLink String?
  spots             Int?
  zoomLink          String?

  @@index([published])
  @@index([date])
}

model EventRegistration {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  eventSlug          String
  eventName          String
  firstName          String
  lastName           String
  email              String
  whatsapp           String?
  role               String?
  goal               String?
  referral           String?
  paymentMethod      String
  price              Int      @default(0)
  currency           String   @default("USD")
  status             String   @default("pending")
  notes              String?
  confirmationNumber String?  @unique
  stripeSessionId    String?

  @@index([eventSlug])
  @@index([email])
  @@index([createdAt])
}

// ── The TIBLOGICS Learn method (lib/learn/method) ───────────────────────────
// Created at runtime with CREATE TABLE IF NOT EXISTS (lib/learn/method/db.ts);
// keep the two in step.

/// Daily Review: one Leitner card per (learner, question). questionId is a
/// MicroCheckQuestion or QuizQuestion id (kind says which; sourceId is the
/// micro-check or quiz it belongs to).
model ReviewCard {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  kind       String // micro|quiz
  sourceId   String
  trackId    String
  box        Int       @default(1)
  dueAt      DateTime  @default(now())
  lastSeenAt DateTime?
  streak     Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([studentId, questionId])
  @@index([studentId, dueAt])
}

/// The Learning Loop's Reflect step: private to the learner.
model LessonReflection {
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([studentId, lessonId])
  @@index([studentId])
}

/// Proof-of-Skill Portfolio sharing settings.
model PortfolioSettings {
  studentId   String   @id
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(false)
  slug        String   @unique
  includeWork Boolean  @default(false)
  /// Sections the learner chose not to share: labs|studio|capstone|certificates|badges
  hidden      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A one-time purchase of one Learning Box track: lifetime access to that
/// track. Created at runtime (lib/learn/purchases.ts) by the Stripe webhook;
/// keep the two in step. trackId is not a foreign key so a purchase record
/// (revenue) survives a track being deleted.
model TrackPurchase {
  id                  String   @id @default(cuid())
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trackId             String
  amountCents         Int
  currency            String   @default("usd")
  stripeSessionId     String?  @unique
  stripePaymentIntent String?
  createdAt           DateTime @default(now())

  @@unique([studentId, trackId])
  @@index([trackId])
  @@index([createdAt])
}

/// Work in progress that has not been submitted yet: workbench and prompt lab
/// answers, Code Studio code and versions, Learning Studio designs, capstone
/// notes, and the last reading position in a lesson ("pos:<lessonId>").
/// Created at runtime (lib/learn/drafts/db.ts); keep the two in step.
model LearnerDraft {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// lab:<labId> | code:<labId> | studio:<toolId>:<challengeId> | capstone:<capstoneId> | pos:<lessonId>
  key       String
  value     Json
  /// Bytes of the JSON value, for the per-draft limit.
  size      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, key])
  @@index([studentId, updatedAt])
}

/// Tutor, the AI tutor side panel: one open conversation per learner per
/// page (lesson, lab, Studio tool, Daily Review). "New conversation" closes
/// the open one. Older messages are folded into `summary` so the context sent
/// to the model stays bounded. Created at runtime (lib/learn/tutor/db.ts),
/// with foreign keys to Student and TutorThread there; keep the two in step.
model TutorThread {
  id              String    @id @default(cuid())
  studentId       String
  /// lesson:<lessonId> | lab:<labId> | studio:<toolId> | review
  contextKey      String
  kind            String
  lessonId        String?
  trackId         String?
  summary         String    @default("") @db.Text
  /// How many of the oldest messages `summary` already covers.
  summarizedCount Int       @default(0)
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([studentId, contextKey, closedAt])
  @@index([lessonId])
}

model TutorMessage {
  id        String   @id @default(cuid())
  threadId  String
  /// user | assistant
  role      String
  content   String   @db.Text
  /// Quick action or "explain" (selected text), for usage stats.
  action    String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([createdAt])
}

/// "Tell Tutor about you": optional, so examples fit the learner's field.
model TutorProfile {
  studentId String   @id
  role      String   @default("")
  goal      String   @default("")
  level     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ── Mastery-based learning paths ────────────────────────────────────────────
// Created at runtime (lib/learn/mastery/db.ts); keep the two in step. Plain id
// columns, no Prisma relations, so these models never edit Student, Lesson or
// LearnModule; the runtime SQL adds cascading foreign keys.

/// Per learner, per module: how much of the module the learner already knows
/// (level: mastered | partial | new), from the placement diagnostic.
model MasteryEstimate {
  id        String   @id @default(cuid())
  studentId String
  trackId   String
  moduleId  String
  level     String
  /// 0..100: share of the module's diagnostic questions answered correctly.
  score     Int
  correct   Int      @default(0)
  asked     Int      @default(0)
  /// diagnostic
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, moduleId])
  @@index([studentId, trackId])
}

/// One run of a track's placement diagnostic. plan: the questions picked per
/// module (ids only); answers: what was answered and whether it was right.
model DiagnosticSession {
  id          String    @id @default(cuid())
  studentId   String
  trackId     String
  /// in_progress | completed | abandoned
  status      String    @default("in_progress")
  plan        Json
  answers     Json
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId, trackId, createdAt])
}

/// A lesson counted as known without being studied: the learner tested out of
/// its module (passed the module quiz from a Mastered estimate). Distinct from
/// LessonProgress (completed), so analytics can tell the two apart.
model LessonMastery {
  studentId  String
  lessonId   String
  moduleId   String
  trackId    String
  /// test_out
  source     String   @default("test_out")
  masteredAt DateTime @default(now())

  @@id([studentId, lessonId])
  @@index([studentId, moduleId])
  @@index([trackId])
}

// ── Community: cohorts, discussion, peer review ─────────────────────────────
// Created at runtime (lib/learn/community/db.ts); keep the two in step. Plain
// id columns, no Prisma relations, so these models never edit Student,
// LearnTrack, Lesson or CapstoneSubmission; the runtime SQL adds the foreign
// keys (cascading on Student, LearnTrack and CapstoneSubmission).

/// A cohort: a group taking one track together over set dates, with a weekly
/// live session (sessionWeekday 0 = Sunday, sessionTime "HH:MM" in timezone).
model Cohort {
  id             String    @id @default(cuid())
  trackId        String
  name           String
  startDate      DateTime
  endDate        DateTime
  sessionWeekday Int
  sessionTime    String
  timezone       String
  sessionMinutes Int       @default(60)
  meetingUrl     String?
  capacity       Int       @default(30)
  enrolmentOpen  Boolean   @default(true)
  priceNote      String?
  /// [{ title, url, addedAt }]
  recordings     Json      @default("[]")
  /// Start of the live session the 24h reminder was last sent for.
  remindedFor    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([trackId])
}

model CohortMember {
  cohortId    String
  studentId   String
  joinedAt    DateTime  @default(now())
  lastNudgeAt DateTime?

  @@id([cohortId, studentId])
  @@index([studentId])
}

model CohortAnnouncement {
  id        String   @id @default(cuid())
  cohortId  String
  bodyMd    String   @db.Text
  createdAt DateTime @default(now())

  @@index([cohortId, createdAt])
}

/// A discussion thread: on a lesson (lessonId), on a track (neither), or
/// visible to one cohort only (cohortId).
model CommunityThread {
  id           String    @id @default(cuid())
  trackId      String
  lessonId     String?
  cohortId     String?
  authorId     String
  title        String
  bodyMd       String    @db.Text
  answerPostId String?
  answeredAt   DateTime?
  score        Int       @default(0)
  replyCount   Int       @default(0)
  hidden       Boolean   @default(false)
  deletedAt    DateTime?
  editedAt     DateTime?
  lastPostAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([trackId, lastPostAt])
  @@index([lessonId])
  @@index([cohortId])
  @@index([authorId])
}

model CommunityPost {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  bodyMd    String    @db.Text
  score     Int       @default(0)
  hidden    Boolean   @default(false)
  deletedAt DateTime?
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
  @@index([authorId])
}

/// One upvote per learner per thread or post (targetType: thread | post).
model CommunityVote {
  studentId  String
  targetId   String
  targetType String
  createdAt  DateTime @default(now())

  @@id([studentId, targetId])
}

/// status: open | resolved | dismissed
model CommunityReport {
  id         String    @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, targetId])
  @@index([status, createdAt])
}

/// Community settings and moderation state per learner.
model CommunityProfile {
  studentId      String    @id
  replyDigest    Boolean   @default(true)
  lastDigestAt   DateTime?
  suspendedUntil DateTime?
  suspendReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

/// A capstone submission entered into peer review by its author.
model PeerReviewOptIn {
  submissionId String   @id
  studentId    String
  trackId      String
  createdAt    DateTime @default(now())

  @@index([trackId])
  @@index([studentId])
}

/// One peer's advisory review of a submission. feedback:
/// [{ criterion, rating (1-5 or null), text }]. status: assigned | submitted.
model PeerReview {
  id           String    @id @default(cuid())
  submissionId String
  reviewerId   String
  trackId      String
  status       String    @default("assigned")
  feedback     Json      @default("[]")
  hidden       Boolean   @default(false)
  helpful      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?

  @@unique([submissionId, reviewerId])
  @@index([reviewerId])
  @@index([trackId])
}

/// Lesson video extras (lib/learn/video/db.ts creates the table). The link
/// itself is Lesson.videoUrl. chapters: [{ time (seconds), title }];
/// captions: { en?, fr?, sw? } WebVTT text per language.
model LessonVideoMeta {
  lessonId  String   @id
  chapters  Json     @default("[]")
  captions  Json     @default("{}")
  /// Generated narrated videos per language: { en?, fr? } each
  /// { url, webm?, chapters, captions, durationSec, voice, generatedAt }.
  variants  Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

/// Whether a lesson gets a generated narrated video (lib/learn/video/select.ts)
/// and its scene script once drafted (lib/learn/video/scenes.ts).
/// source: rule | ai | default; override: include | exclude | null.
model LessonVideoPlan {
  lessonId    String   @id
  contentHash String
  decision    Boolean  @default(false)
  reason      String   @default("")
  source      String   @default("rule")
  override    String?
  estChars    Int      @default(0)
  script      Json?
  scriptHash  String?
  updatedAt   DateTime @default(now())
}

/// One narrated-video generation job per lesson and language (en | fr).
/// status: queued | running | done | failed | needs_tts | skipped.
model LessonVideoJob {
  id          String    @id
  lessonId    String
  locale      String
  status      String    @default("queued")
  contentHash String    @default("")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  error       String?
  chars       Int       @default(0)
  durationSec Float     @default(0)
  provider    String?
  assetId     String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  leaseUntil  DateTime?
  updatedAt   DateTime  @default(now())

  @@unique([lessonId, locale])
  @@index([status])
}

/// A stored generated video file. storage: object (Replit Object Storage,
/// objectKey) | db (LessonVideoChunk rows of chunkSize bytes).
model LessonVideoAsset {
  id          String   @id
  lessonId    String
  locale      String
  contentType String
  size        Int
  etag        String
  storage     String
  objectKey   String?
  chunkSize   Int      @default(0)
  durationSec Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([lessonId])
}

/// Bytes of a LessonVideoAsset stored in the database, in order.
model LessonVideoChunk {
  assetId String
  idx     Int
  data    Bytes

  @@id([assetId, idx])
}

/// A learner's place in a lesson video. coverage: 100 "0"/"1" buckets of the
/// video seen; watchedAt is set once 80% has been seen.
model VideoProgress {
  studentId   String
  lessonId    String
  positionSec Float     @default(0)
  durationSec Float     @default(0)
  coverage    String    @default("")
  watchedAt   DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@id([studentId, lessonId])
  @@index([lessonId])
}

/// Versions of the AI-drafted (then edited) video script for a lesson.
/// content: { title, targetMinutes, notes, sections[] } (lib/learn/video/shared.ts).
model VideoScript {
  id        String   @id @default(cuid())
  lessonId  String
  version   Int
  content   Json
  /// ai | edit
  source    String   @default("ai")
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([lessonId, version])
}

// ── Team plans (lib/learn/team) ─────────────────────────────────────────────
// Created at runtime (lib/learn/team/db.ts); keep the two in step. Plain id
// columns, no Prisma relations; the runtime SQL adds the foreign keys.

/// A company's seats. status: pending | active | trialing | past_due |
/// canceled | comped. seatPriceCents null = the default (lib/learn/team/settings.ts).
model Team {
  id                      String    @id @default(cuid())
  name                    String
  ownerStudentId          String
  seats                   Int       @default(5)
  status                  String    @default("pending")
  seatPriceCents          Int?
  comped                  Boolean   @default(false)
  stripeCustomerId        String?
  stripeSubscriptionId    String?   @unique
  stripeCheckoutSessionId String?
  currentPeriodEnd        DateTime?
  graceUntil              DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  settings                Json      @default("{}")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@index([ownerStudentId])
  @@index([status])
}

/// A seat. studentId is null until the invitation is accepted.
/// role: owner | manager | member. status: invited | active | removed.
model TeamMember {
  id              String    @id @default(cuid())
  teamId          String
  studentId       String?
  email           String
  role            String    @default("member")
  status          String    @default("invited")
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String?
  invitedAt       DateTime  @default(now())
  joinedAt        DateTime?
  removedAt       DateTime?

  @@unique([teamId, email])
  @@index([studentId])
}

/// A track a manager assigned to a member, with an optional due date.
model TeamAssignment {
  id             String    @id @default(cuid())
  teamId         String
  studentId      String
  trackId        String
  dueAt          DateTime?
  assignedById   String?
  lastRemindedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([teamId, studentId, trackId])
  @@index([studentId])
}

// ── Learner sign-in history (lib/learn/logins.ts) ───────────────────────────
// Created at runtime there; keep the two in step. Plain id column, no Prisma
// relation (Student is not edited); the runtime SQL adds a cascading foreign
// key. No passwords, no full IPs: ipPrefix is IPv4 /24 or IPv6 /48.

/// One successful TIBLOGICS Learn sign-in. method: password |
/// owner-admin-password | invite. Rows older than 400 days are pruned.
model LoginEvent {
  id         String   @id @default(cuid())
  studentId  String
  at         DateTime @default(now())
  ipPrefix   String?
  /// Trimmed to 300 characters.
  userAgent  String?
  /// desktop | mobile | tablet | bot | unknown
  deviceType String?
  browser    String?
  os         String?
  /// ISO country code from the edge geo header, when the host sets one.
  country    String?
  method     String   @default("password")

  @@index([studentId, at])
  @@index([at])
}

// ── Verified skill badges (lib/learn/skill-badges) ──────────────────────────
// Open Badges 3.0 credentials, finer grained than certificates. Created at
// runtime by lib/learn/skill-badges/db.ts; keep the two in step. Plain id
// columns, no Prisma relations (Student is not edited); the runtime SQL adds
// a cascading foreign key to Student.

/// One awarded skill badge. badgeKey is the catalog key ("module:<track>:<n>",
/// "studio:<tool>", "capstone:<track>", "skill:<slug>"). credential is the
/// signed OpenBadgeCredential exactly as served; facts are frozen at award.
model SkillBadgeAward {
  id           String    @id
  studentId    String
  badgeKey     String
  family       String
  name         String
  /// Track slugs whose certificate revocation also revokes this badge.
  trackSlugs   Json      @default("[]")
  /// [{ name, description }]: what was passed, never the learner's work.
  evidence     Json      @default("[]")
  issuedAt     DateTime  @default(now())
  /// Per-award salt for the hashed email identity.
  salt         String
  credential   Json
  /// sha256 fingerprint of the signing public key ("" when unsigned).
  keyFp        String    @default("")
  /// false when signed with an ephemeral development key (or not at all).
  signed       Boolean   @default(false)
  isPublic     Boolean   @default(true)
  /// Set when the badge was awarded by a lazy backfill: no toast.
  notifiedAt   DateTime?
  revokedAt    DateTime?
  revokedReason String?

  @@unique([studentId, badgeKey])
  @@index([studentId])
}

// ── Study reminders: WhatsApp and email (lib/learn/reminders) ───────────────
// Created at runtime by lib/learn/reminders/db.ts; keep the two in step. Plain
// id columns, no Prisma relation (Student is not edited); the runtime SQL adds
// cascading foreign keys.

/// A learner's reminder settings. WhatsApp needs a phone number and an
/// explicit consent (consentAt + the wording they agreed to). An inbound STOP
/// sets optedOutAt and turns WhatsApp off. days: weekdays, 0 = Sunday.
model StudyReminderPref {
  studentId     String    @id
  whatsappOn    Boolean   @default(false)
  phoneE164     String?
  emailOn       Boolean   @default(false)
  /// "HH:MM", wall clock in `timezone`.
  timeLocal     String    @default("18:00")
  timezone      String    @default("UTC")
  days          String    @default("1,2,3,4,5")
  /// en | fr
  language      String    @default("en")
  consentAt     DateTime?
  consentText   String?
  optedOutAt    DateTime?
  /// settings | whatsapp_stop
  optOutSource  String?
  /// Set after 3 reminders in a row were ignored: nothing is sent until then.
  pausedUntil   DateTime?
  ignoredCount  Int       @default(0)
  lastSentAt    DateTime?
  /// WhatsApp delivery status of the last message: sent | delivered | read | failed
  lastStatus    String?
  lastStatusAt  DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phoneE164])
}

/// One reminder per learner per local day. The row is inserted (claimed)
/// before the message is sent, so overlapping runs never send twice.
/// status: claimed | sent | failed | skipped
model StudyReminderLog {
  id         String   @id @default(cuid())
  studentId  String
  /// "YYYY-MM-DD" in the learner's time zone.
  day        String
  channel    String
  status     String   @default("claimed")
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, day])
  @@index([providerId])
}

// ── Claude API usage log (lib/ai-usage.ts) ──────────────────────────────────
// Created at runtime there; keep the two in step. No relations: studentId is
// a plain column. One row per model call (or per Message Batches result).

/// One Claude call: task (lib/claude.ts AiTask), model, tokens and the
/// estimated cost in US cents (list prices; batch results at half price).
model AiUsage {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  task             String
  model            String
  batch            Boolean  @default(false)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costCents        Float    @default(0)
  stopReason       String?
  studentId        String?
  ref              String?

  @@index([createdAt])
  @@index([task, createdAt])
}

// ── Live expert sessions (lib/learn/live) ───────────────────────────────────
// Created at runtime (lib/learn/live/db.ts); keep the two in step. Plain id
// columns, no Prisma relations; the runtime SQL adds cascading foreign keys
// (RSVPs, questions and votes go with their session or learner).

/// A monthly live session with a guest expert. status: scheduled | live |
/// ended | cancelled. trackIds: JSON array of related track ids ([] = all).
model ExpertSession {
  id              String   @id @default(cuid())
  title           String
  expertName      String
  expertBio       String?  @db.Text
  expertPhotoUrl  String?
  topic           String?
  trackIds        Json     @default("[]")
  startsAt        DateTime
  durationMinutes Int      @default(60)
  /// IANA zone the session was planned in (display and emails).
  timezone        String   @default("UTC")
  /// Handed out only on "Join", inside the window, to learners with a seat.
  meetingUrl      String?
  capacity        Int      @default(100)
  status          String   @default("scheduled")
  recordingUrl    String?
  /// [{ title, url }]
  resources       Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([startsAt])
}

/// An RSVP. status: going (a seat) | waitlist (ordered by createdAt). The
/// reminded*For columns hold the start time each reminder was sent for, so a
/// moved session is reminded again; joinedAt is attendance (first "Join").
model ExpertSessionRsvp {
  sessionId        String
  studentId        String
  status           String    @default("going")
  createdAt        DateTime  @default(now())
  promotedAt       DateTime?
  reminded24For    DateTime?
  reminded1For     DateTime?
  recordingSentFor String?
  joinedAt         DateTime?

  @@id([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId, status, createdAt])
}

/// A question for the expert, asked before the session.
model ExpertSessionQuestion {
  id         String    @id @default(cuid())
  sessionId  String
  authorId   String
  body       String    @db.Text
  score      Int       @default(0)
  hidden     Boolean   @default(false)
  answeredAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([authorId])
}

model ExpertSessionVote {
  questionId String
  studentId  String
  createdAt  DateTime @default(now())

  @@id([questionId, studentId])
  @@index([studentId])
}

// ── Growth: leads + outreach (lib/growth/outreach) ─────────────────────────
// Created idempotently at runtime by lib/growth/outreach/db.ts (no
// migrations in this project). No Prisma relations, so the shared models
// stay untouched; keep the SQL there in step with these.

/// One row per business in the unified lead workspace (Aria, Prospects, CSV, manual).
model GrowthLead {
  id              String    @id @default(cuid())
  source          String    @default("manual")
  sourceId        String?
  companyName     String
  contactName     String?
  role            String?
  email           String?
  phone           String?
  phoneNorm       String?
  website         String?
  domain          String?
  industry        String?
  area            String?
  linkedinUrl     String?
  stage           String    @default("new")
  score           Int?
  scoreReasons    Json      @default("[]")
  bestOffer       String?
  offerReason     String?
  opener          String?
  signals         Json      @default("{}")
  socials         Json      @default("{}")
  publicEmails    Json      @default("[]")
  emailStatus     String    @default("unknown")
  enrichStatus    String    @default("idle")
  enrichError     String?
  enrichedAt      DateTime?
  consentBasis    String    @default("unset")
  consentNote     String?
  doNotContact    Boolean   @default(false)
  notes           String?   @db.Text
  tags            Json      @default("[]")
  lastContactedAt DateTime?
  repliedAt       DateTime?
  handedOverAt    DateTime?
  handoverRef     String?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([source, sourceId])
  @@index([stage])
  @@index([domain])
  @@index([email])
  @@index([phoneNorm])
  @@index([enrichStatus])
}

/// Lead timeline: enriched, emailed, replied, handed over...
model GrowthLeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  detail    String?  @db.Text
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

/// A multi-step email sequence. steps: [{dayOffset, subject, body, personalise}]
model OutreachSequence {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  status      String   @default("active")
  offerKey    String?
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model OutreachEnrollment {
  id         String    @id @default(cuid())
  sequenceId String
  leadId     String
  status     String    @default("pending_approval")
  stopReason String?
  approvedAt DateTime?
  /// Tracked /go short link for this lead's booking CTA (lib/growth/links), if created.
  linkCode   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([sequenceId, leadId])
  @@index([leadId])
  @@index([status])
}

/// One email of one enrollment. Nothing sends until status is "approved".
model OutreachMessage {
  id            String    @id @default(cuid())
  enrollmentId  String
  sequenceId    String
  leadId        String
  stepIndex     Int
  dayOffset     Int       @default(0)
  toEmail       String?
  subject       String
  bodyText      String    @db.Text
  personalised  Boolean   @default(false)
  status        String    @default("draft")
  approvedAt    DateTime?
  approvedBy    String?
  scheduledFor  DateTime?
  claimId       String?
  claimedAt     DateTime?
  sentAt        DateTime?
  error         String?
  smtpMessageId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([enrollmentId, stepIndex])
  @@index([status, scheduledFor])
  @@index([leadId])
  @@index([sentAt])
}

/// Global do-not-email list: an address, or "@domain" for a whole domain.
model OutreachSuppression {
  value     String   @id
  reason    String
  source    String?
  note      String?
  createdAt DateTime @default(now())
}

/// Sender run lock (one row, id "sender").
model OutreachState {
  id          String    @id
  lockedUntil DateTime?
  lastRunAt   DateTime?
  lastResult  Json      @default("{}")
}

