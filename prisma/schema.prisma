  marketingOptOut    Boolean   @default(false)
  deletedAt          DateTime?
  updatedAt          DateTime  @default(now())

  @@index([status])
}

/// SHA-256 of a blocked learner's lower-cased email: sign-up and sign-in refused.
model LearnerBlockedEmail {
