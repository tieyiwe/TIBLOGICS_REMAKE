generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_URL")
  directUrl = env("SUPABASE_URL")
}

model Appointment {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  serviceType     String
  serviceDuration String
  servicePrice    Int
  date            DateTime
  timeSlot        String
  timezone        String    @default("America/New_York")
  firstName       String
  lastName        String
  email           String
  company         String?
  phone           String?
  goalNotes       String?
  addOnRecording      Boolean @default(false)
  addOnActionPlan     Boolean @default(false)
  addOnSlackAccess    Boolean @default(false)
  totalAmount     Int
  status          AppointmentStatus @default(PENDING)
  stripeSessionId  String?
  stripePaymentId  String?
  paymentStatus    String?
  zoomLink         String?
  notes            String?
  reminderSent     Boolean   @default(false)
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  @@index([email])
  @@index([date])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Prospect {
  id                 String         @id @default(cuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  name               String
  business           String
  industry           String
  mainChallenge      String
  budget             String
  suggestedSolutions String[]
  email              String?
  phone              String?
  source             ProspectSource @default(TIBS_ADVISOR)
  status             ProspectStatus @default(NEW)
  priority           String?
  estimatedValue     Int?
  notes              String?
  followUpDate       DateTime?
  convertedAt        DateTime?
  conversationLog    Json?
  archived           Boolean        @default(false)

  @@index([status])
  @@index([createdAt])
  @@index([archived])
}

enum ProspectSource {
  TIBS_ADVISOR
  WEBSITE_SCANNER
  CONTACT_FORM
  REFERRAL
  MANUAL
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

model ScannerLead {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  url           String
  overallScore  Int
  seoScore      Int
  perfScore     Int
  uxScore       Int
  aiScore       Int
  findings      Json
  aiDescription String
  email         String?
  name          String?
  bookedCallAt  DateTime?

  @@index([createdAt])
  @@index([aiScore])
}

model ToolUsage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tool      String
  sessionId String?
  metadata  Json?
}

model AdminSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Project {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  name             String
  description      String?
  category         ProjectCategory
  status           ProjectStatus   @default(ACTIVE)
  priority         ProjectPriority @default(MEDIUM)
  progress         Int             @default(0)
  color            String          @default("#2251A3")
  revenueEarned    Int             @default(0)
  revenuePotential Int             @default(0)
  monthlyRecurring Int             @default(0)
  startDate        DateTime?
  deadline         DateTime?
  completedAt      DateTime?
  starred          Boolean         @default(false)
  archived         Boolean         @default(false)
  notes            String?
  tasks            ProjectTask[]

  @@index([category])
  @@index([status])
}

enum ProjectCategory {
  SAAS
  CLIENT
  EDUCATION
  INTERNAL
}

enum ProjectStatus {
  CONCEPT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProjectTask {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  dueDate   DateTime?
  order     Int      @default(0)

  @@index([projectId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String?
  whatsapp       String?
  source         String    @default("blog")
  active         Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([active])
  @@index([subscribedAt])
}

model NewsletterCampaign {
  id             String    @id @default(cuid())
  title          String
  subject        String
  previewText    String?
  contentHtml    String    @db.Text
  category       String    @default("general")
  status         String    @default("DRAFT")
  sentAt         DateTime?
  recipientCount Int       @default(0)
  sentBy         String    @default("Echelon")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ServiceRequest {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  service      String
  description  String   @db.Text
  budget       String?
  timeline     String?
  tiboAssisted Boolean  @default(false)
  aiSummary    String?  @db.Text
  status       String   @default("NEW")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.Text
  content       String   @db.Text
  category      String
  tags          String[]
  coverImage    String?
  coverEmoji    String   @default("🤖")
  coverGradient String   @default("from-[#1B3A6B] to-[#2251A3]")
  author        String   @default("Echelon AI")
  readingTime   Int      @default(5)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  aiGenerated   Boolean  @default(false)
  sourceUrl     String?
  sourceTitle   String?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([createdAt])
}

model BreakingNews {
  id        String    @id @default(cuid())
  headline  String
  summary   String
  sourceUrl String?
  source    String?
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model BlogRefreshLog {
  id         String   @id @default(cuid())
  success    Boolean
  postsAdded Int      @default(0)
  message    String?
  createdAt  DateTime @default(now())
}

model CommandCenterSync {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  projectId   String?
  projectName String
  action      String
  source      String
  changesDiff Json
  chatSummary String?
  undoneAt    DateTime?
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  referrer  String?
  origin    String   @default("direct")
  device    String   @default("desktop")
  browser   String?
  os        String?
  ip        String?
  country   String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([origin])
}

model ActiveSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  page      String
  device    String   @default("desktop")
  browser   String?
  os        String?
  origin    String   @default("direct")
  country   String?
  ip        String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([lastSeen])
}

model Collaborator {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          String    @default("CUSTOM")
  permissions   String[]
  isAdmin       Boolean   @default(false)
  active        Boolean   @default(true)
  inviteToken   String?   @unique
  inviteExpires DateTime?
  invitedBy     String
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activityLogs  CollaboratorActivityLog[]

  @@index([email])
  @@index([inviteToken])
}

model CollaboratorActivityLog {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  action         String
  resource       String
  resourceId     String?
  details        String?
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([collaboratorId])
  @@index([createdAt])
  @@index([resource])
}

model AgentLead {
  id            String          @id @default(cuid())
  source        String          @default("ai_generated")
  companyName   String
  contactName   String?
  email         String?
  phone         String?
  website       String?
  location      String?
  industry      String?
  description   String?         @db.Text
  notes         String?         @db.Text
  status        AgentLeadStatus @default(NEW)
  fromAgent     String          @default("aria")
  assignedTo    String?
  callSid           String?
  callStatus        String?
  callNotes         String?   @db.Text
  callTranscript    String?   @db.Text
  callSummary       String?   @db.Text
  blandCallId       String?
  interestedIn      String[]
  hasWebsite        Boolean?
  businessInfo      Json?
  scrapedAt         DateTime?
  area              String?
  transferredAt     DateTime?
  contactedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([fromAgent])
  @@index([assignedTo])
}

enum AgentLeadStatus {
  NEW
  TRANSFERRED
  CONTACTED
  HOT
  WARM
  COLD
  UNINTERESTED
  CONVERTED
}

model AgentMessage {
  id        String   @id @default(cuid())
  fromAgent String
  toAgent   String
  type      String   @default("notification")
  subject   String?
  payload   Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model AgentRun {
  id        String   @id @default(cuid())
  agent     String
  action    String
  status    String   @default("running")
  input     Json?
  output    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agent])
  @@index([status])
}

model PartnershipApplication {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  website      String?
  address      String?
  description  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  product   String
  createdAt DateTime @default(now())

  @@unique([email, product])
  @@index([product])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// TIBLOGICS LEARN — course platform
// Status-like columns are String (validated in lib/learn/types.ts) rather than
// Postgres enums, so the raw-SQL sync-db path stays idempotent and simple.
// ═══════════════════════════════════════════════════════════════════════════

model Student {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  email             String    @unique
  passwordHash      String
  name              String
  emailVerified     DateTime?
  verifyToken       String?   @unique
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  accessibilityMode Boolean   @default(false)
  locale            String    @default("en")
  leaderboardOptIn  Boolean   @default(false)
  lastLoginAt       DateTime?

  subscription  LearnSubscription?
  progress      LessonProgress[]
  microAttempts MicroCheckAttempt[]
  quizAttempts  QuizAttempt[]
  examSessions  FinalExamSession[]
  capstones     CapstoneSubmission[]
  points        PointsLedger[]
  certificates  LearnCertificate[]

  @@index([email])
}

model LearnTrack {
  id                   String  @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  slug                 String  @unique
  title                String
  titleFr              String?
  tagline              String?
  description          String  @db.Text
  descriptionFr        String? @db.Text
  level                String  @default("beginner")   // starter|beginner|intermediate|advanced
  levelEnd             String?                         // set when the track spans levels
  status               String  @default("draft")       // draft|coming_soon|live
  sortOrder            Int     @default(0)
  accentColor          String  @default("#F47C4C")
  heroImage            String?
  outcomes             Json    @default("[]")
  audience             String?
  certificateName      String
  estimatedHours       Float   @default(0)
  estimatedWeeksAt3Hrs Int?

  modules      LearnModule[]
  finalExam    FinalExam?
  capstone     Capstone?
  certificates LearnCertificate[]

  @@index([status])
  @@index([sortOrder])
}

model LearnModule {
  id               String @id @default(cuid())
  trackId          String
  track            LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  sortOrder        Int
  estimatedMinutes Int    @default(0)

  lessons    Lesson[]
  quiz       Quiz?
  examQs     FinalExamQuestion[]

  @@index([trackId])
}

model Lesson {
  id              String  @id @default(cuid())
  moduleId        String
  module          LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  sortOrder       Int
  contentType     String  @default("mixed")  // video|article|mixed
  videoUrl        String?
  bodyMd          String  @db.Text
  durationMinutes Int     @default(0)
  objective       String?
  isPreview       Boolean @default(false)
  hasPractice     Boolean @default(false)

  resources  LessonResource[]
  microCheck MicroCheck?
  progress   LessonProgress[]

  @@index([moduleId])
}

model LessonResource {
  id           String  @id @default(cuid())
  lessonId     String
  lesson       Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  url          String
  resourceType String  @default("tool")  // tool|article|video|dataset|template|account_signup
  isFree       Boolean @default(true)
  isRequired   Boolean @default(false)
  notes        String?
  sortOrder    Int     @default(0)
  lastCheckedStatus Int?                 // admin link checker result

  @@index([lessonId])
}

// ── Tier 1: micro-checks (after every lesson) ──────────────────────────────
model MicroCheck {
  id             String @id @default(cuid())
  lessonId       String @unique
  lesson         Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passScore      Int    @default(67)
  questionsServed Int   @default(3)

  questions MicroCheckQuestion[]
  attempts  MicroCheckAttempt[]
}

model MicroCheckQuestion {
  id           String @id @default(cuid())
  microCheckId String
  microCheck   MicroCheck @relation(fields: [microCheckId], references: [id], onDelete: Cascade)
  question     String @db.Text
  options      Json
  correctIndex Int
  explanation  String @db.Text

  @@index([microCheckId])
}

model MicroCheckAttempt {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  microCheckId String
  microCheck   MicroCheck @relation(fields: [microCheckId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  answers      Json
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([microCheckId])
}

// ── Tier 2: module quizzes ─────────────────────────────────────────────────
model Quiz {
  id              String @id @default(cuid())
  moduleId        String @unique
  module          LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  passScore       Int    @default(80)
  questionsServed Int    @default(8)

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question     String @db.Text
  options      Json
  correctIndex Int
  explanation  String @db.Text

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([quizId])
}

// ── Tier 3: timed final exam ───────────────────────────────────────────────
model FinalExam {
  id                String @id @default(cuid())
  trackId           String @unique
  track             LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title             String
  timeLimitMinutes  Int
  questionsServed   Int
  passScore         Int    @default(75)
  distinctionScore  Int    @default(90)
  maxAttempts       Int    @default(3)
  cooldownHours     Int    @default(24)
  instructionsMd    String @db.Text

  questions FinalExamQuestion[]
  sessions  FinalExamSession[]
}

model FinalExamQuestion {
  id           String  @id @default(cuid())
  finalExamId  String
  finalExam    FinalExam @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       LearnModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  question     String  @db.Text
  options      Json
  correctIndex Int
  explanation  String  @db.Text
  difficulty   Int     @default(2)   // 1=recall 2=application 3=analysis

  @@index([finalExamId])
  @@index([moduleId])
}

model FinalExamSession {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  finalExamId     String
  finalExam       FinalExam @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  status          String    @default("in_progress")  // in_progress|submitted|expired
  questionIds     Json
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  score           Int?
  passed          Boolean?
  answers         Json      @default("{}")
  perModuleScores Json?
  attemptNumber   Int       @default(1)

  @@index([studentId])
  @@index([finalExamId])
  @@index([status])
}

// ── Capstone ───────────────────────────────────────────────────────────────
model Capstone {
  id            String @id @default(cuid())
  trackId       String @unique
  track         LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  briefMd       String @db.Text
  rubric        Json
  passThreshold Int    @default(70)

  submissions CapstoneSubmission[]
}

model CapstoneSubmission {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  capstoneId    String
  capstone      Capstone  @relation(fields: [capstoneId], references: [id], onDelete: Cascade)
  status        String    @default("submitted")  // submitted|in_review|revisions_requested|passed|failed
  submissionUrl String?
  submissionMd  String?   @db.Text
  reviewerNotes String?   @db.Text
  aiPrereviewMd String?   @db.Text
  score         Int?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentId])
  @@index([capstoneId])
  @@index([status])
}

// ── Learner state ──────────────────────────────────────────────────────────
model LearnSubscription {
  id                   String    @id @default(cuid())
  studentId            String    @unique
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  status               String    @default("trialing")  // trialing|active|past_due|canceled
  plan                 String    @default("monthly")   // monthly|annual
  currentPeriodEnd     DateTime?
  graceUntil           DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

model LessonProgress {
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([studentId, lessonId])
  @@index([studentId])
  @@index([completedAt])
}

model PointsLedger {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  source    String   // lesson_complete|micro_check_pass|quiz_pass|quiz_perfect|final_exam_pass|final_exam_distinction|capstone_pass|streak_bonus|track_complete
  refId     String?
  points    Int
  createdAt DateTime @default(now())

  @@unique([studentId, source, refId])
  @@index([studentId])
}

model LearnCertificate {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trackId        String
  track          LearnTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  verificationId String   @unique @default(uuid())
  recipientName  String
  certificateName String
  distinction    Boolean  @default(false)
  examScore      Int?
  issuedAt       DateTime @default(now())
  pdfUrl         String?
  revoked        Boolean  @default(false)

  @@unique([studentId, trackId])
  @@index([verificationId])
}

model LearnWaitlist {
  id        String   @id @default(cuid())
  email     String
  trackSlug String
  createdAt DateTime @default(now())

  @@unique([email, trackSlug])
  @@index([trackSlug])
}

model Product {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  slug           String   @unique
  name           String
  tagline        String?
  description    String   @db.Text
  price          Int      @default(0)   // current price in cents
  compareAtPrice Int?                   // original price (strike-through when on sale)
  currency       String   @default("USD")
  images         String[]               // image URLs (first = primary)
  category       String   @default("General")
  collections    String[]               // slugs of collections this product belongs to
  tags           String[]
  stock          Int?                   // null = not tracked / unlimited
  digital        Boolean  @default(true)  // digital => no shipping address collected
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  onSale         Boolean  @default(false)
  sku            String?
  soldCount      Int      @default(0)

  @@index([published])
  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  description String   @default("")
  image       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@index([published])
  @@index([featured])
}

model AbandonedCart {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  email        String    @unique
  items        Json                       // [{ id, slug, name, price, image, quantity }]
  subtotal     Int       @default(0)
  currency     String    @default("USD")
  reminderCount Int      @default(0)
  lastReminderAt DateTime?
  recoveredAt  DateTime?

  @@index([recoveredAt])
  @@index([updatedAt])
}

model Order {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderNumber     String   @unique
  email           String
  customerName    String?
  phone           String?
  items           Json                    // [{ productId, slug, name, price, quantity, image }]
  subtotal        Int      @default(0)
  total           Int      @default(0)
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | fulfilled | cancelled | refunded
  stripeSessionId String?
  shippingAddress Json?
  notes           String?

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Event {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  title            String
  slug             String   @unique
  description      String   @db.Text
  content          String?  @db.Text
  type             String   @default("TRAINING")
  price            Int      @default(0)
  currency         String   @default("USD")
  capacity         Int?
  location         String   @default("Online")
  date             DateTime?
  endDate          DateTime?
  timeSlot         String?
  timezone         String   @default("America/New_York")
  coverImage       String?
  tags             String[]
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  registrationOpen Boolean  @default(true)
  stripePaymentLink String?
  spots            Int?
  zoomLink         String?

  @@index([published])
  @@index([date])
}

model EventRegistration {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  eventSlug          String
  eventName          String
  firstName          String
  lastName           String
  email              String
  whatsapp           String?
  role               String?
  goal               String?
  referral           String?
  paymentMethod      String
  price              Int      @default(0)
  currency           String   @default("USD")
  status             String   @default("pending")
  notes              String?
  confirmationNumber String?  @unique
  stripeSessionId    String?

  @@index([eventSlug])
  @@index([email])
  @@index([createdAt])
}
