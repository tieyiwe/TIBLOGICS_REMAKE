  @@index([at])
  @@index([actorEmail, at])
  @@index([action, at])
  @@index([targetType, targetId])
}

/// Saved message for the communications center. kind: marketing | service.
model CommsTemplate {
  id        String   @id
  name      String
  kind      String   @default("service")
  subject   String
  body      String
  subjectFr String?
  bodyFr    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

/// One send to learners. status: scheduled | starting | sending | sent | cancelled.
model CommsCampaign {
  id             String    @id
  kind           String    @default("service")
  subject        String
  body           String
  subjectFr      String?
  bodyFr         String?
  viaEmail       Boolean   @default(true)
  viaInbox       Boolean   @default(true)
