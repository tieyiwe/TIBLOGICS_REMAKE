// ── Learner account controls, admin audit log, communications and Inbox ──
// Tables created at runtime (lib/learn/account-status/db.ts,
// lib/admin/audit.ts, lib/learn/inbox/db.ts); keep these models in step.
// Plain id columns, no Prisma relations (Student is not edited); the
// runtime SQL adds cascading foreign keys to Student.

/// Account status of an ARFA learner. No row = active.
/// status: active | suspended | blocked | deleted (anonymised).
model LearnerAccount {
